{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "noEmitOnError": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "../dist",
    "rootDir": "../.."
  },
  "include": [
    "./**/*.ts",
    "../types/**/*.d.ts",
    "../../src/lib/game/ai/**/*.ts"
  ]
}

